<Tag Name="Error_KnifeCarriageControl" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Comments>
<Comment Operand=".0">
<![CDATA[233M1 Knife carriage feed drive cooling fan]]>
</Comment>
<Comment Operand=".1">
<![CDATA[Knife carriage position difference]]>
</Comment>
<Comment Operand=".2">
<![CDATA[Knife carriage feed drive initialization failed]]>
</Comment>
<Comment Operand=".3">
<![CDATA[232M1 Knife carriage drive not ready]]>
</Comment>
<Comment Operand=".4">
<![CDATA[Knife carriage drive fault]]>
</Comment>
<Comment Operand=".5">
<![CDATA[Rotating nose bar not running]]>
</Comment>
<Comment Operand=".6">
<![CDATA[Top roll not running]]>
</Comment>
<Comment Operand=".7">
<![CDATA[Knife carriage position check failure]]>
</Comment>
<Comment Operand=".8">
<![CDATA[Knife carriage position data read error]]>
</Comment>
<Comment Operand=".9">
<![CDATA[Knife carriage drive data read error]]>
</Comment>
<Comment Operand=".10">
<![CDATA[Knife carriage drive controller failure]]>
</Comment>
<Comment Operand=".11">
<![CDATA[Drive Knife carriage to the greasing position]]>
</Comment>
<Comment Operand=".13">
<![CDATA[Thickness change failed]]>
</Comment>
</Comments>
<Data Format="L5K">
<![CDATA[0]]>
