<Routines Use="Context">
<Routine Use="Target" Name="L11_KnifeCarriageCtrl" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CONTROL ENABLE]]>
</Comment>
<Text>
<![CDATA[XIC(KC_DataRead_OK)XIC(KnifeCarr_Home_Pos_Init_Ready)[XIO(AnyError_KnifeCarriageControl) ,XIC(_KC_DriveGreasingPos) ]OTE(KC_Control_Enable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[LIMITS]]>
</Comment>
<Text>
<![CDATA[[LE(KC_Abs_Pos_10_mm,1120) ,[XIC(KC_ManualForward_Fast) ,XIC(KC_ManualForward_Slow) ] LE(KC_Abs_Pos_10_mm,1375) ]XIO(Spdls_OuterChucksRETRD)OTE(Limits_OuterChucksRetracted_Fail);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(trash_gate_disable)[[XIC(KC_Steps.2) ,XIC(KC_Steps.3) ,XIC(KC_Steps.4) ] XIC(I_JS_RightStep_1) XIC(Trashgate_Has_Been_Closed) OTL(KC_FeedStopped) ,[XIC(KC_Steps.6) ,XIC(Spdls_InnerChucksRETRD) ] OTU(KC_FeedStopped) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[LE(KC_Abs_Pos_10_mm,720) ,[XIC(KC_ManualForward_Fast) ,XIC(KC_ManualForward_Slow) ] LE(KC_Abs_Pos_10_mm,900) ]XIO(Spdls_MiddleChucksRETRD)OTE(Limits_MiddleChucksRetracted_Fail);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[CORE RADIUS MINIMUM LIMIT]]>
</Comment>
<Text>
<![CDATA[ADD(Spindles_InnerChucksRad_mm,25,mm_MinimCoreRadius);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Always_0)[MOVE(46,HMI_Lathe_Core_Radius_SetVal1) ,MOVE(65,HMI_Lathe_Core_Radius_SetVal2) ,MOVE(160,HMI_Lathe_Core_Radius_LimVolRad1) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(HMI_Lathe_DualCoreSize_Toggle)_Toggle(_TwoCoreSizeToggle,HMI_Lathe_DualCoreSize_Enabled,_TwoCoreSizeToggle.OUT_OnPulse);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[CORE RADIUS BASED ON BLOCK VOLUME DIAMETER
Diam < 320 = core radius 45.5 (diam 91)
Diam >320 = core radius 65 (diam 130)]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Lathe_DualCoreSize_Enabled)XIC(FROM_ChargerSwing_AT_Lathe)[MOVE(HMI_Lathe_Core_Radius_SetVal1,_CoreRadiusTemp) ,GT(MsgChargerTOLatheTbl[4],HMI_Lathe_Core_Radius_LimVolRad1) MOVE(HMI_Lathe_Core_Radius_SetVal2,_CoreRadiusTemp) ,MUL(_CoreRadiusTemp,10,HMI_Lathe_Core_Radius) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(FROM_ChargerSwing_AT_Lathe)CPT(VeneerRibbonLengthEstimate,3.14*(MsgChargerTOLatheTbl[5]*MsgChargerTOLatheTbl[5]-(HMI_Lathe_Core_Radius*HMI_Lathe_Core_Radius/100.0))/(MIS_LatheRecipe_IOi3*10.0));]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[LT(HMI_Lathe_Core_Radius,mm_MinimCoreRadius)MOVE(mm_MinimCoreRadius,HMI_Lathe_Core_Radius);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOVE(HMI_Lathe_Core_Radius,KC_CoreRadius_mm);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[SUB(IO_XY_To_Lathe_DATA3,KC_Extra_Retract_Adder,KC_Extra_Retract_Threshold);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(KC_Control_Enable)XIO(KC_SynchronRun)XIO(KC_ManualRun)XIC(Spdls_InnerChucksRETRD)XIC(Lathe_Automatic_Mode)XIO(KC_Retracting)LT(KC_Abs_Pos_10_mm,IO_XY_To_Lathe_DATA3)LE(KC_Abs_Pos_10_mm,KC_Extra_Retract_Threshold)OTE(KC_ExtraRetract);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE RETURN RADIUS]]>
</Comment>
<Text>
<![CDATA[[SUB(Data_ReturnRad,10,_KC_RetractPos_mm) GT(_KC_RetractPos_mm,4200) MOVE(4190,_KC_RetractPos_mm) ,[GT(_KC_RetractPos_mm,1500) MUL(_KC_RetractPos_mm,KC_Retract_Variables[3],_KC_RetractCloseTOClear) ,GT(_KC_RetractPos_mm,2000) MUL(_KC_RetractPos_mm,KC_Retract_Variables[2],_KC_RetractCloseTOClear) ,GT(_KC_RetractPos_mm,2500) MUL(_KC_RetractPos_mm,KC_Retract_Variables[1],_KC_RetractCloseTOClear) ,GT(_KC_RetractPos_mm,3500) MUL(_KC_RetractPos_mm,KC_Retract_Variables[0],_KC_RetractCloseTOClear) ,LE(_KC_RetractPos_mm,1500) MUL(_KC_RetractPos_mm,KC_Retract_Variables[4],_KC_RetractCloseTOClear) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[ADD(Spindles_ClosedChucksRad,200,KC_FastForwardRad_mm);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Test_Fast_KC_Retract)[GT(HMI_Lathe_Peel_Thickness1,300) MOVE(3,KC_CoreRadiusAdder_mm) ,LE(HMI_Lathe_Peel_Thickness1,300) MOVE(2,KC_CoreRadiusAdder_mm) ,ADD(KC_CoreRadius_mm,KC_CoreRadiusAdder_mm,KC_CoreRadiusMod_mm) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[CORE RADIUS REACHED]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)[XIC(CarriageDrive.Status.InCoreLimit) XIC(CarriageDrive.Status.DriveAt0Speed) ,XIC(Test_Fast_KC_Retract) XIC(CarriageDrive.Status.InCoreLimit) LE(KC_Abs_Pos_10_mm,KC_CoreRadiusMod_mm) ,LE(KC_Abs_Pos_10_mm,KC_CoreRadius_mm) ]OTE(KC_CoreRadiusReached);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE RETRACTED]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)GE(KC_Abs_Pos_10_mm,_KC_RetractPos_mm)XIO(KC_PeelingBeenOn)OTE(KC_Retracted);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE RETRACTING]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIC(KC_Steps.6)[TON(_T_KC_Retracting_delay,?,?) XIC(_T_KC_Retracting_delay.DN) ,]OTE(KC_Retracting);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE IS MOVING BACKWARD]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIC(KC_Retracting)ONS(_ONS_1.1)MOVE(KC_Abs_Pos_10_mm,_KC_AbsPos10mm_Old);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(KC_Control_Enable)XIC(KC_Retracting)GT(KC_Abs_Pos_10_mm,_KC_AbsPos10mm_Old)MOVE(KC_Abs_Pos_10_mm,_KC_AbsPos10mm_Old)OTE(KC_MovedBackward);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE IS CLEAR FOR NEXT BLOCK]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)[XIC(KC_Retracted) ,XIC(_KC_Retracted_temp) XIO(KC_Steps.2) XIO(KC_Steps.4) ,GE(KC_Abs_Pos_10_mm,_KC_RetractPos_mm) ,SUB(_KC_RetractPos_mm,50,_KC_RetractPos_TGT_Window) GE(KC_Abs_Pos_10_mm,_KC_RetractPos_TGT_Window) ,XIC(KC_MovedBackward) GT(KC_ActSpeed_10,1500) GT(KC_Abs_Pos_10_mm,_KC_RetractCloseTOClear) ][OTE(KC_ClearFORBlk) ,OTE(_KC_Retracted_temp) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[PEELING ENABLE FROM ROLLER NOSE BAR]]>
</Comment>
<Text>
<![CDATA[[LE(rpm_ActSpindleSpeed10,200) ,XIO(RollerBarRot_RotStopped_LHS) ,XIO(RollerBarRot_RotStopped_RHS) ]TOF(_T_EnableFromRollerBar,?,?);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[XIC(_T_EnableFromRollerBar.DN) ,]OTE(KC_PeelingEnableFromRollerBar);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[PEELING ENABLE]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIO(Error_LatheMasterSeq.1)XIC(KC_PeelingEnableFromRollerBar)XIO(MotorStart_Service)XIC(I_Pilz_1_LS_StairwaySafeDoorLHS_Clsd)XIC(I_Pilz_1_LS_StairwaySafeDoorRHS_Clsd)XIC(I_Pilz_2_LS_TrashGateLock_OFF)XIC(TopRoll_CommandEnable)XIC(BottomRoll_CommandEnable)XIC(PitchAngle_Control_Enable)XIC(Roller_Bar_Control_Enable)XIC(I_M_TopRollRotHydrRun)XIC(I_M_BottomRollRotHydrRun)XIC(Spindles_OperationEnable)OTE(KC_PeelingEnable);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[CARRIAGE STEPS

STEP #1 - READY FOR NEXT BLOCK
STEP #2 - ROUND UP
STEP #3 - ROUNDUP PEEL
STEP #4 - PEELING
STEP #5 - AT CORE LIMIT
STEP #6 - CORE DROP / RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(KC_PeelingEnable)XIC(KC_Steps.6)[XIC(KC_KnifeCarrRetracted) ,]XIC(CarriageDrive.Status.AtPosition)MOVE(1,KC_StepNumber);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[CARRIAGE STEPS

STEP #1 - READY FOR NEXT BLOCK
STEP #2 - ROUND UP
STEP #3 - ROUNDUP PEEL
STEP #4 - PEELING
STEP #5 - AT CORE LIMIT
STEP #6 - CORE DROP / RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(KC_PeelingEnable)[XIC(Lathe_Step_6) XIO(Auto_Roundup_Has_Been_On) ,XIC(Lathe_Step_7) XIO(Auto_Roundup_Has_Been_On) ,XIC(Lathe_Step_4) XIC(Lathe_Spindle_Drive_Running) XIC(Auto_Roundup_Step_Has_Been_On) XIO(Auto_Roundup_Has_Been_On) EQ(KC_StepNumber,0) XIC(Test_Bit_Pasi) ,XIC(OUT_JS_Roundup) ]XIC(Spindles_Rotation_ON)XIO(CarriageDrive.Status.InCoreLimit)[[[XIC(Tipple_IsDOWN) ,XIC(Lathe_Tipple_To_Lower_Tray) ] XIC(Catch_Up_Tray_Lower_StandBy) XIC(CatchUpConvLower_RunningFW) ,[XIC(Tipple_IsUP) ,XIC(Lathe_Tipple_To_Upper_Tray) ] XIC(Catch_Up_Tray_Upper_StandBy) XIC(CatchUpConvUpper_RunningFW) ] OTE(Trays_Ready_For_Peeling) ,XIC(HMI_Lathe_RUpEarlyStart_Enabled) XIC(Trashgate_IsOpened) ]MOVE(2,KC_StepNumber);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[CARRIAGE STEPS

STEP #1 - READY FOR NEXT BLOCK
STEP #2 - ROUND UP
STEP #3 - ROUNDUP PEEL
STEP #4 - PEELING
STEP #5 - AT CORE LIMIT
STEP #6 - CORE DROP / RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(KC_PeelingEnable)XIC(OUT_JS_RoundupPeel)XIC(Spindles_Rotation_ON)XIO(CarriageDrive.Status.InCoreLimit)[[XIC(Tipple_IsDOWN) ,XIC(Lathe_Tipple_To_Lower_Tray) ] XIC(Catch_Up_Tray_Lower_StandBy) ,[XIC(Tipple_IsUP) ,XIC(Lathe_Tipple_To_Upper_Tray) ] XIC(Catch_Up_Tray_Upper_StandBy) ]MOVE(3,KC_StepNumber);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[CARRIAGE STEPS

STEP #1 - READY FOR NEXT BLOCK
STEP #2 - ROUND UP
STEP #3 - ROUNDUP PEEL
STEP #4 - PEELING
STEP #5 - AT CORE LIMIT
STEP #6 - CORE DROP / RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(KC_PeelingEnable)[XIC(Lathe_Step_8) XIO(Auto_Peeling_Has_Been_On) XIO(OUT_JS_Roundup) ,XIC(OUT_JS_Peeling) XIO(Lathe_Step_8) ,XIC(OUT_JS_RoundupPeel) ]XIO(CarriageDrive.Status.InCoreLimit)[[XIC(Lathe_Tipple_And_Trays_Ready) XIC(Spindles_Rotation_ON) [XIC(Tipple_IsDOWN) [XIC(Catch_Up_Tray_Lower_StandBy) ,XIC(Test_Bits[0].2) XIC(Catch_Up_Tray_Lower_FrontEndPassed) ONS(ONS_Knife_Carriage0.1) XIC(KCWaitingCatchUpConveyorsForPeeling) ] XIC(CatchUpConvLower_RunningFW) ,XIC(Tipple_IsUP) [XIC(Catch_Up_Tray_Upper_StandBy) ,XIC(Test_Bits[0].2) XIC(Catch_Up_Tray_Upper_FrontEndPassed) ONS(ONS_Knife_Carriage0.2) XIC(KCWaitingCatchUpConveyorsForPeeling) ] XIC(CatchUpConvUpper_RunningFW) ] MOVE(4,KC_StepNumber) ,[[XIO(Tipple_IsDOWN) ,XIO(Catch_Up_Tray_Lower_StandBy) ,XIO(CatchUpConvLower_RunningFW) ] [XIO(Tipple_IsUP) ,XIO(Catch_Up_Tray_Upper_StandBy) ,XIO(CatchUpConvUpper_RunningFW) ] ,XIO(Clipper_ControlEnable) ,XIO(Lathe_Tipple_And_Trays_Ready) ] [OTE(KCWaitingCatchUpConveyorsForPeeling) ,ONS(ONS.0) ADD(PRUCounters[0],1,PRUCounters[0]) ] ] ,XIO(Spindles_Rotation_ON) OTE(KCWaitingSpindleRotationForPeeling) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[CARRIAGE STEPS

STEP #1 - READY FOR NEXT BLOCK
STEP #2 - ROUND UP
STEP #3 - ROUNDUP PEEL
STEP #4 - PEELING
STEP #5 - AT CORE LIMIT
STEP #6 - CORE DROP / RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(Always_0)XIC(KC_PeelingEnable)[XIC(KC_Steps.2) XIC(Lathe_Step_7) ,XIC(KC_Steps.4) XIC(Lathe_Step_7) ,[XIC(KC_Steps.5) XIC(Lathe_Step_7) ,XIC(CarriageDrive.Status.InCoreLimit) ,LE(KC_Abs_Pos_10_mm,HMI_Lathe_Core_Radius) ] ]MOVE(5,KC_StepNumber);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[CARRIAGE STEPS

STEP #1 - READY FOR NEXT BLOCK
STEP #2 - ROUND UP
STEP #3 - ROUNDUP PEEL
STEP #4 - PEELING
STEP #5 - AT CORE LIMIT
STEP #6 - CORE DROP / RETRACT]]>
</Comment>
<Text>
<![CDATA[XIC(KC_PeelingEnable)[XIC(KC_CoreRadiusReached) ,XIC(KC_PeelingBeenOn) XIC(OUT_JS_StopPeelOpnChucks) XIO(Spdls_InnerChucksRETRD) XIC(Spdls_MiddleChucksRETRD) XIC(Spdls_MiddleChucksRETRD) ,XIC(Spindles_Spinout) CTU(Diagnostic[0],?,?) ,[XIC(TopRoll_Spinout) ,XIC(BottomRoll_Spinout) ] LT(KC_Abs_Pos_10_mm,800) CTU(Diagnostic[1],?,?) ]MOVE(6,KC_StepNumber);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[CLEAR STEP NUMBER IN CASE OF DISTURBANCE]]>
</Comment>
<Text>
<![CDATA[[XIO(KC_Control_Enable) ,XIC(Limits_OuterChucksRetracted_Fail) ,XIC(Limits_MiddleChucksRetracted_Fail) ,XIC(OUT_JS_StopKnifeCarrFeed) ,XIC(OUT_JS_StopPeelOpnChucks) XIO(Spdls_MiddleChucksRETRD) ,XIC(OUT_JS_KnifeCarrBackward) ,XIC(KC_DrivingError) ,XIC(AnyError_KnifeCarriageControl) ,XIO(KC_PeelingEnable) [XIO(KC_Steps.6) ,XIC(KC_KnifeCarrRetracted) ] ,[XIC(TopRoll_Spinout) ,XIC(BottomRoll_Spinout) ] GE(KC_Abs_Pos_10_mm,800) ]CLR(KC_StepNumber);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[CARRIAGE CURRENT STEP #1]]>
</Comment>
<Text>
<![CDATA[EQ(KC_StepNumber,1)OTE(KC_Steps.1);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[CARRIAGE CURRENT STEP #2]]>
</Comment>
<Text>
<![CDATA[EQ(KC_StepNumber,2)OTE(KC_Steps.2);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[CARRIAGE CURRENT STEP #2]]>
</Comment>
<Text>
<![CDATA[EQ(KC_StepNumber,3)OTE(KC_Steps.3);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[CARRIAGE CURRENT STEP #4]]>
</Comment>
<Text>
<![CDATA[EQ(KC_StepNumber,4)OTE(KC_Steps.4);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[CARRIAGE CURRENT STEP #5]]>
</Comment>
<Text>
<![CDATA[EQ(KC_StepNumber,5)OTE(KC_Steps.5);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[CARRIAGE CURRENT STEP #6]]>
</Comment>
<Text>
<![CDATA[EQ(KC_StepNumber,6)OTE(KC_Steps.6);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[PEELING CYCLE HAS BEEN STARTED]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Steps.2) ,XIC(KC_Steps.4) ,XIC(Lathe_Spindle_Drive_Running) ]OTL(KC_PeelingBeenOn);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[[XIC(KC_Steps.6) ,XIC(Spdls_InnerChucksRETRD) ]OTU(KC_PeelingBeenOn);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[GT(HMI_Lathe_HeavyPeel_Offset,0)GT(HMI_Lathe_HeavyPeel_Wrap,0)OTE(_KC_HeavyPeel_ENA);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[XIC(_KC_HeavyPeel_ENA)[XIC(KC_Steps.4) ,XIC(KC_Steps.3) ][OTE(_KC_HeavyPeel_CMD) ,ONS(_ONS_KC.28) [MOVE(HMI_Lathe_HeavyPeel_Offset,_KC_HeavyPeel_Offset) ,DIV(HMI_Lathe_HeavyPeel_Wrap,10,_KC_HeavyPeel_FullWraps) ,CPT(_KC_HeavyPeel_WrapOffset,HMI_Lathe_HeavyPeel_Offset*10/HMI_Lathe_HeavyPeel_Wrap) ] ];]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIC(_KC_HeavyPeel_CMD)XIC(RollerBar_IsClosed)ONS(_ONS_KC.29)[MOVE(KC_Abs_Pos_10_mm,_KC_HeavyPeel_StartPOS) ,CPT(_KC_HeavyPeel_EndPOS,KC_Abs_Pos_10_mm-(HMI_Lathe_Peel_Thickness1*HMI_Lathe_HeavyPeel_Wrap/100)) ,CPT(_KC_HeavyPeel_TGT,KC_Abs_Pos_10_mm-(HMI_Lathe_Peel_Thickness1/10)) ,OTL(_KC_HeavyPeelCalcs_DONE) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIC(_KC_HeavyPeel_CMD)XIC(RollerBar_IsClosed)GT(_KC_HeavyPeel_FullWraps,0)LT(KC_Abs_Pos_10_mm,_KC_HeavyPeel_TGT)[SUB(_KC_HeavyPeel_Offset,_KC_HeavyPeel_WrapOffset,_KC_HeavyPeel_Offset) ,LT(_KC_HeavyPeel_Offset,0) MOVE(0,_KC_HeavyPeel_Offset) ,SUB(_KC_HeavyPeel_FullWraps,1,_KC_HeavyPeel_FullWraps) ,CPT(_KC_HeavyPeel_TGT,_KC_HeavyPeel_TGT-(HMI_Lathe_Peel_Thickness1/10)) ];]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[[XIO(_KC_HeavyPeel_CMD) ,XIC(_KC_HeavyPeelCalcs_DONE) LT(KC_Abs_Pos_10_mm,_KC_HeavyPeel_EndPOS) ][MOVE(0,_KC_HeavyPeel_Offset) ,OTU(_KC_HeavyPeelCalcs_DONE) ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE MANUALLY FORWARD SLOWLY]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)[XIO(MotorStart_Service) XIC(I_Pilz_1_LS_StairwaySafeDoorLHS_Clsd) XIC(I_Pilz_1_LS_StairwaySafeDoorRHS_Clsd) XIC(OUT_JS_KnifeCarrForward) XIC(Lathe_Spindle_Drive_Running) ,XIC(MotorStart_Service) XIC(I_PB_ButtonsEna_204C) XIC(I_PB_KnifeCarrFW_204C) ]OTE(KC_ManualForward_Slow);]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE MANUALLY FORWARD FAST]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIO(MotorStart_Service)XIC(I_Pilz_1_LS_StairwaySafeDoorLHS_Clsd)XIC(I_Pilz_1_LS_StairwaySafeDoorRHS_Clsd)XIC(OUT_JS_KnifeCarrForward)XIO(Lathe_Spindle_Drive_Running)OTE(KC_ManualForward_Fast);]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE MANUALLY BACKWARD SLOWLY]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIC(MotorStart_Service)XIC(I_PB_ButtonsEna_204C)XIC(I_PB_KnifeCarrBW_204C)OTE(KC_ManualBackward_Slow);]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE MANUALLY BACKWARD FAST]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIO(MotorStart_Service)XIC(I_Pilz_1_LS_StairwaySafeDoorLHS_Clsd)XIC(I_Pilz_1_LS_StairwaySafeDoorRHS_Clsd)XIC(OUT_JS_KnifeCarrBackward)OTE(KC_ManualBackward_Fast);]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[[XIC(KC_ManualForward_Slow) ,XIC(KC_ManualForward_Fast) ]MOVE(1000,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Text>
<![CDATA[AFI()[XIC(KC_ManualBackward_Slow) ,XIC(KC_ManualBackward_Fast) ]MOVE(6000,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Comment>
<![CDATA[CHECK DELTA / DRIVE SENSORS DIFFERENCE]]>
</Comment>
<Text>
<![CDATA[XIO(Error_KnifeCarriageControl.1)[XIC(KC_ManualForward_Slow) ,XIC(KC_ManualForward_Fast) ,XIC(KC_ManualBackward_Slow) ,XIC(KC_ManualBackward_Fast) ,XIC(KC_Steps.2) ,XIC(KC_Steps.4) ]SUB(KC_Abs_Pos_10_mm,CarriageDrive.CurrentPosition,_KC_PosSensorDifference)[GT(_KC_PosSensorDifference,25) ,XIO(_KC_DiffSensorPosit) LT(_KC_PosSensorDifference,-25) ]OTL(_KC_DiffSensorPosit);]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Text>
<![CDATA[XIO(Error_KnifeCarriageControl.1)XIC(_KC_DiffCurrCycle_1)XIC(_KC_DiffCurrCycle_2)OTE(_KC_DiffCurrCycle_3);]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Text>
<![CDATA[XIO(Error_KnifeCarriageControl.1)XIC(_KC_DiffSensorPosit)XIC(_KC_DiffCurrCycle_1)OTE(_KC_DiffCurrCycle_2);]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Text>
<![CDATA[XIO(Error_KnifeCarriageControl.1)XIC(_KC_DiffSensorPosit)OTE(_KC_DiffCurrCycle_1);]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Text>
<![CDATA[XIO(Error_KnifeCarriageControl.1)OTU(_KC_DiffSensorPosit);]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Comment>
<![CDATA[POSITION CHECK PROXY SWITCH

Min and Max should be set 20 counts (2mm) above and below the average detection range. eg if average is arounf 1000 then Min = 980, Max = 1020
See Rungs below to find average.

Calibrated 06/11/2025. If this alarm is on, time to replace the actuator.]]>
</Comment>
<Text>
<![CDATA[[XIC(I_PR_KnifeCarrPos_RHS1) ONS(_ONS_KC.2) [LT(KC_Abs_Pos_10_mm,912) [CTU(_PositionCheckFailure_Counter[0],?,?) ,MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[0]) ] ,GT(KC_Abs_Pos_10_mm,952) [CTU(_PositionCheckFailure_Counter[1],?,?) ,MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[1]) ] ] ,[XIC(I_PR_KnifeCarrPos_LHS1) ONS(_ONS_KC.3) [LT(KC_Abs_Pos_10_mm,940) [CTU(_PositionCheckFailure_Counter[2],?,?) ,MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[2]) ] ,GT(KC_Abs_Pos_10_mm,980) [CTU(_PositionCheckFailure_Counter[3],?,?) ,MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[3]) ] ] ,LT(KC_Abs_Pos_10_mm,910) XIO(I_PR_KnifeCarrPos_RHS1) [CTU(_PositionCheckFailure_Counter[4],?,?) ,MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[4]) ] ,LT(KC_Abs_Pos_10_mm,910) XIO(I_PR_KnifeCarrPos_LHS1) [CTU(_PositionCheckFailure_Counter[5],?,?) ,ONS(_ONS_1.3) MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[5]) ] ] ]OTL(_PositionCheckFailure);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Text>
<![CDATA[[XIO(I_PR_KnifeCarrPos_RHS1) ONS(_ONS_1.4) MOVE(KC_Abs_Pos_10_mm,_PositionCheck_ValuesRHS) ,XIO(I_PR_KnifeCarrPos_LHS1) ONS(_ONS_1.5) MOVE(KC_Abs_Pos_10_mm,_PositionCheck_ValuesLHS) ];]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Comment>
<![CDATA[Average check positions for RHS Knife Carriage check prox.
For use setting Min/Max in Rungs above]]>
</Comment>
<Text>
<![CDATA[XIC(I_PR_KnifeCarrPos_RHS1)ONS(_ONS_KC.4)[MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[6]) ,LT(KC_Abs_Pos_10_mm,_Position_CheckRHS_Min) MOVE(KC_Abs_Pos_10_mm,_Position_CheckRHS_Min) ,GT(KC_Abs_Pos_10_mm,_Position_CheckRHS_Max) MOVE(KC_Abs_Pos_10_mm,_Position_CheckRHS_Max) ];]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Comment>
<![CDATA[Average check positions for LHS Knife Carriage check prox.
For use setting Min/Max in Rungs above]]>
</Comment>
<Text>
<![CDATA[XIC(I_PR_KnifeCarrPos_LHS1)ONS(_ONS_KC.5)[MOVE(KC_Abs_Pos_10_mm,_PositionCheckFailure_Values[7]) ,LT(KC_Abs_Pos_10_mm,_Position_CheckLHS_Min) MOVE(KC_Abs_Pos_10_mm,_Position_CheckLHS_Min) ,GT(KC_Abs_Pos_10_mm,_Position_CheckLHS_Max) MOVE(KC_Abs_Pos_10_mm,_Position_CheckLHS_Max) ];]]>
</Text>
</Rung>
<Rung Number="60" Type="N">
<Text>
<![CDATA[XIC(ErrorReset_Lathe)OTU(_PositionCheckFailure);]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Comment>
<![CDATA[DRIVING IS NOT ALLOWED]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_ManualForward_Slow) ,XIC(KC_ManualForward_Fast) ,XIC(KC_ManualBackward_Slow) ,XIC(KC_ManualBackward_Fast) ,XIC(KC_Steps.2) ,XIC(KC_Steps.4) ][XIC(AnyError_KnifeCarriageControl) ,XIC(CarriageDrive.Status.AtSoftLimits) ,XIC(AnyError_SpindlesControl) XIO(KC_ManualBackward_Slow) XIO(KC_ManualBackward_Fast) ]OTL(KC_DrivingError);]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Text>
<![CDATA[XIC(ErrorReset_Lathe)OTU(KC_DrivingError);]]>
</Text>
</Rung>
<Rung Number="63" Type="N">
<Comment>
<![CDATA[MANUAL RUNNING STOPPED]]>
</Comment>
<Text>
<![CDATA[XIO(KC_ManualBackward_Slow)XIO(KC_ManualBackward_Fast)XIO(KC_ManualForward_Slow)XIO(KC_ManualForward_Fast)[ONS(_ONS_KC.0) OTE(_KC_ManualRunningStopped) ,[XIC(CarriageDrive.Status.DriveAt0Speed) ,XIC(_T_ManualRunningStopped.DN) ] TON(_T_ManualRunningStopped,?,?) ];]]>
</Text>
</Rung>
<Rung Number="64" Type="N">
<Text>
<![CDATA[XIC(_T_ManualRunningStopped.DN)ONS(_ONS_KC.1)OTE(_KC_DriveStopped);]]>
</Text>
</Rung>
<Rung Number="65" Type="N">
<Comment>
<![CDATA[POSITION RUNNING]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_ManualBackward_Slow) ,XIC(KC_ManualBackward_Fast) ,XIC(KC_ManualForward_Slow) ,XIC(KC_ManualForward_Fast) ,XIC(KC_Steps.6) ,XIC(test_Second_Load_Pos) XIC(KC_Steps.1) XIC(KC_ExtraRetract) ]TON(_T_PositionRunning_ON,?,?)XIC(_T_PositionRunning_ON.DN)OTE(_KC_PositionRun);]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Comment>
<![CDATA[SYNCHRON RUNNING]]>
</Comment>
<Text>
<![CDATA[XIO(_KC_PositionRun)TON(_T_SynchronRunning_ON,?,?);]]>
</Text>
</Rung>
<Rung Number="67" Type="N">
<Text>
<![CDATA[[XIC(KC_Steps.2) ,XIC(KC_Steps.4) ]XIC(_T_SynchronRunning_ON.DN)OTE(_KC_SynchronRunning);]]>
</Text>
</Rung>
<Rung Number="68" Type="N">
<Text>
<![CDATA[XIC(_KC_SynchronRunning)OSF(_ONS_1.2,_KC_SynchronRunStopped);]]>
</Text>
</Rung>
<Rung Number="69" Type="N">
<Text>
<![CDATA[XIC(KC_Steps.6)LE(_KC_RetractPos_mm,0)MUL(HMI_Lathe_Man_Return_Rad,10,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="70" Type="N">
<Text>
<![CDATA[GE(KC_Abs_Pos_10_mm,_KC_RetractPos_mm)OTE(KC_KnifeCarrRetracted);]]>
</Text>
</Rung>
<Rung Number="71" Type="N">
<Text>
<![CDATA[[XIC(Limits_MiddleChucksRetracted_Fail) ,XIC(Limits_OuterChucksRetracted_Fail) ]OTE(KC_StopDrive);]]>
</Text>
</Rung>
<Rung Number="72" Type="N">
<Text>
<![CDATA[XIC(_KC_PositionRun)XIO(KC_StopDrive)OTE(KC_ManualRun);]]>
</Text>
</Rung>
<Rung Number="73" Type="N">
<Text>
<![CDATA[XIC(_KC_SynchronRunning)XIO(KC_StopDrive)OTE(KC_SynchronRun);]]>
</Text>
</Rung>
<Rung Number="74" Type="N">
<Comment>
<![CDATA[TARGET FOR DRIVE]]>
</Comment>
<Text>
<![CDATA[XIO(KC_Retracting)[XIC(_KC_SynchronRunStopped) ,XIC(_KC_DriveStopped) ]MOVE(KC_Abs_Pos_10_mm,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="75" Type="N">
<Comment>
<![CDATA[MANUALLY FORWARD TARGET]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_ManualForward_Slow) ,XIC(KC_ManualForward_Fast) ]MOVE(KC_FastForwardRad_mm,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="76" Type="N">
<Comment>
<![CDATA[MANUALLY BACKWARD TARGET]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_ManualBackward_Slow) ,XIC(KC_ManualBackward_Fast) ][XIO(MotorStart_Service) MOVE(4200,_KC_KnifeCarrTarget) ,[XIC(MotorStart_Service) ,XIO(KC_ManualBackward_Fast) XIC(_KC_DriveGreasingPos) ] MOVE(6120,_KC_KnifeCarrTarget) ];]]>
</Text>
</Rung>
<Rung Number="77" Type="N">
<Comment>
<![CDATA[RETRACT TARGET]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Retracting) ONS(ONS_Knife_Carriage0.0) ,XIC(test_Second_Load_Pos) XIC(KC_Steps.1) XIC(KC_ExtraRetract) ONS(ONS_Knife_Carriage0.3) ][MOVE(_KC_RetractPos_mm,_KC_KnifeCarrTarget) ,GT(_KC_RetractPos_mm,4200) MOVE(4200,_KC_KnifeCarrTarget) ,LT(_KC_RetractPos_mm,KC_Abs_Pos_10_mm) MOVE(KC_Abs_Pos_10_mm,_KC_KnifeCarrTarget) ];]]>
</Text>
</Rung>
<Rung Number="78" Type="N">
<Comment>
<![CDATA[MIN / MAX TARGET

####RujaPa 24.4.2013 Added KC_Control_Enable to first branch to prevent home pos init failure]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Control_Enable) XIO(KC_ManualForward_Slow) XIO(KC_ManualForward_Fast) LT(_KC_KnifeCarrTarget,KC_CoreRadius_mm) MOVE(KC_CoreRadius_mm,_KC_KnifeCarrTarget) ,[XIC(KC_ManualForward_Slow) ,XIC(KC_ManualForward_Fast) ] LT(KC_Abs_Pos_10_mm,_KC_KnifeCarrTarget) MOVE(KC_Abs_Pos_10_mm,_KC_KnifeCarrTarget) ,XIC(KC_Control_Enable) GT(_KC_KnifeCarrTarget,6150) MOVE(6150,_KC_KnifeCarrTarget) ,[XIC(KC_ManualBackward_Slow) ,XIC(KC_ManualBackward_Fast) ] GT(KC_Abs_Pos_10_mm,_KC_KnifeCarrTarget) MOVE(KC_Abs_Pos_10_mm,_KC_KnifeCarrTarget) ];]]>
</Text>
</Rung>
<Rung Number="79" Type="N">
<Text>
<![CDATA[GT(_KC_KnifeCarrTarget,6150)MOVE(6150,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="80" Type="N">
<Text>
<![CDATA[LT(_KC_KnifeCarrTarget,mm_MinimCoreRadius)MOVE(mm_MinimCoreRadius,_KC_KnifeCarrTarget);]]>
</Text>
</Rung>
<Rung Number="81" Type="N">
<Text>
<![CDATA[[XIC(KC_Steps.2) ONS(ONS.8) [GT(Data_RoundupRadFromXY,1250) OTL(Medium_Or_Large_Block_In_Lathe) ,LIMIT(1150,Data_RoundupRadFromXY,1250) OTL(Small_Block_In_Lathe) ,LT(Data_RoundupRadFromXY,1150) OTL(Very_Small_Block_In_Lathe) ] ,XIC(KC_Steps.6) OTU(Medium_Or_Large_Block_In_Lathe) OTU(Small_Block_In_Lathe) OTU(Very_Small_Block_In_Lathe) ];]]>
</Text>
</Rung>
<Rung Number="82" Type="N">
<Comment>
<![CDATA[Ribbon break pause time setpoint
From supervisor's HMI]]>
</Comment>
<Text>
<![CDATA[MOVE(SupHMI_RibbonBreakPauseTime,_TrashGateCloseDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="83" Type="N">
<Comment>
<![CDATA[FEEDING THICKNESS]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Steps.2) [XIC(Medium_Or_Large_Block_In_Lathe) MUL(800,10,mm_CurrFeedThick) ,XIC(Small_Block_In_Lathe) MUL(HMI_Lathe_Peel_Thickness1,20,mm_CurrFeedThick) ,XIC(Very_Small_Block_In_Lathe) MUL(HMI_Lathe_Peel_Thickness1,15,mm_CurrFeedThick) ] ,XIC(KC_Steps.2) XIC(Auto_High_Speed_Roundup) XIO(Spindles_6ftBlock) [AFI() XIC(trash_gate_disable) [GT(Data_RoundupRadFromXY,1400) MOVE(6000,mm_CurrFeedThick) ,LIMIT(1200,Data_RoundupRadFromXY,1400) MOVE(4000,mm_CurrFeedThick) ,LE(Data_RoundupRadFromXY,1200) MUL(HMI_Lathe_Peel_Thickness1,10,mm_CurrFeedThick) ] ,XIO(trash_gate_disable) MOVE(6000,mm_CurrFeedThick) ] ,XIC(KC_Steps.2) XIC(Limits_VeryHighSpeedRoundup) GT(HMI_Lathe_Peel_Thickness1,350) XIO(Spindles_6ftBlock) MOVE(6000,mm_CurrFeedThick) ,XIC(KC_Steps.2) XIC(Limits_FastForwardRad) XIC(OUT_JS_KnifeCarrForward) MOVE(30000,mm_CurrFeedThick) ,[XIC(KC_Steps.4) ,XIC(KC_Steps.3) ,XIC(KC_Steps.2) XIC(HMI_Lathe_RUpEarlyStart_Enabled) XIC(KCWaitingCatchUpConveyorsForPeeling) ] [[XIC(KC_Steps.4) ,XIO(trash_gate_disable) ] [ADD(HMI_Lathe_Peel_Thickness1,_KC_HeavyPeel_Offset,_KC_HeavyPeel_Thickness) ,MUL(_KC_HeavyPeel_Thickness,10,mm_CurrFeedThick) ] ,XIC(trash_gate_disable) [[XIC(Trashgate_IsOpened) ,XIC(HMI_Lathe_RUpEarlyStart_Enabled) XIC(KCWaitingCatchUpConveyorsForPeeling) ] XIO(KC_FeedStopped) [MOVE(0,mm_CurrFeedThick) ,TON(_TrashGateCloseDelay,?,?) ] ,[XIC(_TrashGateCloseDelay.DN) ,XIC(KCStopped_CloseTrashGate) ,XIC(Trashgate_Has_Been_Closed) ] OTE(KCStopped_CloseTrashGate) ,XIC(_TrashGateCloseDelay.TT) OTE(RibbonBreakTrashgateBlow) ] ] ];]]>
</Text>
</Rung>
<Rung Number="84" Type="N">
<Text>
<![CDATA[XIC(KCStopped_CloseTrashGate)ONS(_ONS_KC.26)OTL(Trashgate_Has_Been_Closed);]]>
</Text>
</Rung>
<Rung Number="85" Type="N">
<Comment>
<![CDATA[DRIVE KNIFE CARRIAGE TO GREASING POSITION]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Steps.6)XIO(_KC_RetractTemp)[ADD(1,_KC_RetractCounter,_KC_RetractCounter) ,OTL(_KC_RetractTemp) ];]]>
</Text>
</Rung>
<Rung Number="86" Type="N">
<Text>
<![CDATA[[GE(KC_Abs_Pos_10_mm,6100) ,XIC(ErrorReset_Lathe) ]XIC(_KC_DriveGreasingPos)MOVE(0,_KC_RetractCounter);]]>
</Text>
</Rung>
<Rung Number="87" Type="N">
<Text>
<![CDATA[GE(_KC_RetractCounter,30000)OTE(_KC_DriveGreasingPos);]]>
</Text>
</Rung>
<Rung Number="88" Type="N">
<Text>
<![CDATA[XIC(KC_Steps.4)OTU(_KC_RetractTemp);]]>
</Text>
</Rung>
<Rung Number="89" Type="N">
<Comment>
<![CDATA[OUTPUTS]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Steps.2) ,XIC(KC_Steps.3) ,XIC(KC_Steps.4) ]OTE(Q_PL_PeelingOn);]]>
</Text>
</Rung>
<Rung Number="90" Type="N">
<Text>
<![CDATA[AFI()[XIC(KC_Steps.6) ,XIC(_T_SpurKnifeClean.TT) ][TON(_T_SpurKnifeClean,?,?) ,XIC(_T_SpurKnifeClean.TT) OTE(Q_V_SpurKnifeCleaning) ];]]>
</Text>
</Rung>
<Rung Number="91" Type="N">
<Comment>
<![CDATA[ERRORS]]>
</Comment>
