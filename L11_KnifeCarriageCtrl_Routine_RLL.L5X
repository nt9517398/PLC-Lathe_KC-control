<![CDATA[XIC(_KC_DiffCurrCycle_3)OTL(Error_KnifeCarriageControl.1);]]>
</Text>
</Rung>
<Rung Number="92" Type="N">
<Text>
<![CDATA[XIC(_PositionCheckFailure)[OTL(Error_KnifeCarriageControl.7) ,CTU(Error_KnifeCarriageControl7_Counter,?,?) ];]]>
</Text>
</Rung>
<Rung Number="93" Type="N">
<Text>
<![CDATA[XIO(KC_DataRead_OK)OTL(Error_KnifeCarriageControl.8);]]>
</Text>
</Rung>
<Rung Number="94" Type="N">
<Text>
<![CDATA[XIC(_KC_DriveGreasingPos)OTL(Error_KnifeCarriageControl.11);]]>
</Text>
</Rung>
<Rung Number="95" Type="N">
<Text>
<![CDATA[JSR(L12_KnifeCarriageMot,0);]]>
</Text>
