<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Toggles output on rising edge of input]]>
</Comment>
<Text>
<![CDATA[[XIC(EnableIn) ONS(_ons) [OTL(_toggleHelpOut) ,XIC(_toggleHelp) OTU(_toggleHelpOut) ] ,XIC(_toggleHelpOut) OTE(_toggleHelp) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IN_SetOutput)OTL(_toggleHelpOut);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(IN_ResetOutput)OTU(_toggleHelpOut);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(_toggleHelpOut)OTE(EnableOut);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(_toggleHelpOut)[OTE(OUT_Toggle) ,ONS(_ons2) OTE(OUT_OnPulse) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Toggles output on rising edge of input]]>
