<Routines Use="Context">
<Routine Use="Target" Name="L1_LatheMasterSeq" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[PEELING ENABLE]]>
</Comment>
<Text>
<![CDATA[XIC(KC_Control_Enable)XIO(Error_LatheMasterSeq.1)XIC(KC_PeelingEnableFromRollerBar)XIO(MotorStart_Service)XIC(I_Pilz_1_LS_StairwaySafeDoorLHS_Clsd)XIC(I_Pilz_1_LS_StairwaySafeDoorRHS_Clsd)XIC(I_Pilz_2_LS_TrashGateLock_OFF)[XIC(TopRoll_CommandEnable) XIC(BottomRoll_CommandEnable) ,]XIC(PitchAngle_Control_Enable)XIC(Roller_Bar_Control_Enable)XIC(I_M_TopRollRotHydrRun)XIC(I_M_BottomRollRotHydrRun)XIC(Spindles_OperationEnable)XIC(RMC_AllAxes_OK)XIO(RMC_Enet_ERR)XIC(RollerBar_RDY)OTE(LatheMasterSeq_StepsEnable);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[LATHE STEP ENABLE
ALL AXIS OK]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIC(LatheMasterSeq_StepsEnable)OTE(_Step_Enable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[ERROR IS ON]]>
</Comment>
<Text>
<![CDATA[NE(Error_LatheMasterSeq,0)OTL(LatheMasterSeq_Error_Is_On);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[LATHE AUTOMATIC ON / OFF]]>
</Comment>
<Text>
<![CDATA[[XIC(I_PB_LatheAuto) ONS(_ONS_1.2) [XIO(_Lathe_Auto_Toggle) OTL(Lathe_Automatic_Mode) ,XIC(_Lathe_Auto_Toggle) OTU(Lathe_Automatic_Mode) ] ,XIC(Lathe_Automatic_Mode) OTE(_Lathe_Auto_Toggle) ,[XIO(I_LatheRdyStr) ,XIO(RMC_AllAxes_OK) ,[XIO(LatheMasterSeq_StepsEnable) ,XIC(Error_General_1.8) ] ] OTU(Lathe_Automatic_Mode) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[AUTO ROUNDUP ON / OFF]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_Lathe_Switch_Buttons_05) ONS(_ONS_1.3) [XIO(_Roundup_Auto_Toggle) OTL(Roundup_Automatic_Mode) ,XIC(_Roundup_Auto_Toggle) OTU(Roundup_Automatic_Mode) ] ,XIC(Roundup_Automatic_Mode) OTE(_Roundup_Auto_Toggle) ,XIO(Charger_Optim_ON) OTU(Roundup_Automatic_Mode) ,XIC(Charger_Optim_ON) ONS(Roundup_Automatic_Mode_ONS) OTL(Roundup_Automatic_Mode) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[MOVE(200,_Data_CloseHeadTime) ,MOVE(400,_Data_BurToTrackingTime) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Rung 6 &7 for future use for operators to have control of roundup affset]]>
</Comment>
<Text>
<![CDATA[NE(HMI_Lathe_Peel_Thickness1,HMI_Lathe_Peel_Thickness1_Old)[OTE(New_Recipe_Loaded) ,MOVE(HMI_Lathe_Peel_Thickness1,HMI_Lathe_Peel_Thickness1_Old) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(New_Recipe_Loaded) ,XIC(HMI_KnifeChangePB) ]AFI()[LIMIT(100,HMI_Lathe_Peel_Thickness1,280) MOVE(SupHMI_RoundupOffset[0],HMI_Lathe_RoundUp_Offset) ,LIMIT(280,HMI_Lathe_Peel_Thickness1,400) MOVE(SupHMI_RoundupOffset[1],HMI_Lathe_RoundUp_Offset) ,GT(HMI_Lathe_Peel_Thickness1,400) MOVE(SupHMI_RoundupOffset[2],HMI_Lathe_RoundUp_Offset) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(SupHMIRoundupOffsetAdd)ONS(ONS.21)[LIMIT(100,HMI_Lathe_Peel_Thickness1,280) ADD(SupHMI_RoundupOffset[0],1,SupHMI_RoundupOffset[0]) ,LIMIT(280,HMI_Lathe_Peel_Thickness1,400) ADD(SupHMI_RoundupOffset[1],1,SupHMI_RoundupOffset[1]) ,GT(HMI_Lathe_Peel_Thickness1,400) ADD(SupHMI_RoundupOffset[2],1,SupHMI_RoundupOffset[2]) ,GE(SupHMI_RoundupOffset[0],50) MOVE(50,SupHMI_RoundupOffset[0]) ,GE(SupHMI_RoundupOffset[1],50) MOVE(50,SupHMI_RoundupOffset[1]) ,GE(SupHMI_RoundupOffset[2],50) MOVE(50,SupHMI_RoundupOffset[2]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(SupHMIRoundupOffsetSub)ONS(ONS.22)[LIMIT(100,HMI_Lathe_Peel_Thickness1,280) SUB(SupHMI_RoundupOffset[0],1,SupHMI_RoundupOffset[0]) ,LIMIT(280,HMI_Lathe_Peel_Thickness1,400) SUB(SupHMI_RoundupOffset[1],1,SupHMI_RoundupOffset[1]) ,GT(HMI_Lathe_Peel_Thickness1,400) SUB(SupHMI_RoundupOffset[2],1,SupHMI_RoundupOffset[2]) ,LE(SupHMI_RoundupOffset[0],-50) MOVE(-50,SupHMI_RoundupOffset[0]) ,LE(SupHMI_RoundupOffset[1],-50) MOVE(-50,SupHMI_RoundupOffset[1]) ,LE(SupHMI_RoundupOffset[2],-50) MOVE(-50,SupHMI_RoundupOffset[2]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Spdls_InnerChucksEXTD)[GT(Data_ReturnRadFromXY,1900) OTE(SupHMI_BigBlock) ,LIMIT(1500,Data_ReturnRadFromXY,1900) OTE(SupHMI_MediumBlock) ,LT(Data_ReturnRadFromXY,1500) OTE(SupHMI_SmallBlock) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[READ XY DATA]]>
</Comment>
<Text>
<![CDATA[XIC(Spdls_InnerChucksEXTD)ONS(_ONS_1.0)[MOVE(IO_XY_To_Lathe_DATA3,Data_ReturnRadFromXY) ,MOVE(IO_XY_To_Lathe_DATA4,Data_RoundupRadFromXY) ,MOVE(IO_XY_To_Lathe_DATA4,Data_RoundupRadFromXYOriginal) ,XIO(trash_gate_disable) LT(IO_XY_To_Lathe_DATA4,1300) CPT(Data_RoundupRadFromXY,HMI_Lathe_Peel_Thickness1*0.5+Data_RoundupRadFromXY) ,MOVE(IO_XY_To_Lathe_DATA1,Data_BlockLenghtFromXY) ,XIC(New_Roundup_Offset) [LIMIT(100,HMI_Lathe_Peel_Thickness1,280) [GT(Data_ReturnRadFromXY,1900) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[0],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[0],Data_RoundupRad) ,LIMIT(1500,Data_ReturnRadFromXY,1900) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[1],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[0],Data_RoundupRad) ,LT(Data_ReturnRadFromXY,1500) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[2],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[0],Data_RoundupRad) ] ,LIMIT(280,HMI_Lathe_Peel_Thickness1,400) [GT(Data_ReturnRadFromXY,1900) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[3],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[1],Data_RoundupRad) ,LIMIT(1500,Data_ReturnRadFromXY,1900) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[4],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[1],Data_RoundupRad) ,LT(Data_ReturnRadFromXY,1500) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[5],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[1],Data_RoundupRad) ] ,GT(HMI_Lathe_Peel_Thickness1,400) [GT(Data_ReturnRadFromXY,1900) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[6],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[2],Data_RoundupRad) ,LIMIT(1500,Data_ReturnRadFromXY,1900) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[7],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[2],Data_RoundupRad) ,LT(Data_ReturnRadFromXY,1500) ADD(Data_RoundupRadFromXY,Lathe_RoundUp_Offset[8],Data_RoundupRad) ADD(Data_RoundupRad,SupHMI_RoundupOffset[2],Data_RoundupRad) ] ] ,XIO(New_Roundup_Offset) ADD(Data_RoundupRadFromXY,HMI_Lathe_RoundUp_Offset,Data_RoundupRad) ,ADD(Data_RoundupRadFromXYOriginal,HMI_Lathe_RoundUp_Offset,Data_RoundupRadOriginal) ,CPT(Data_HighSpeedRoundupRad,Data_RoundupRadFromXY*1.15) ,CPT(Data_VeryHighSpeedRoundupRad,Data_RoundupRadFromXY*1.25) ,LT(Data_VeryHighSpeedRoundupRad,Min_Rad_VeryHighSpeed) MOVE(Min_Rad_VeryHighSpeed,Data_VeryHighSpeedRoundupRad) CTU(Very_High_Speed_Limit_Trigger,?,?) ,CPT(Data_RoundupPeelRad,HMI_Lathe_Peel_Thickness1*0.2+Data_RoundupRad) ,CPT(Data_RoundupPeelRadOriginal,HMI_Lathe_Peel_Thickness1*0.2+Data_RoundupRadOriginal) ,XIC(FROM_ChargerSwing_AT_Lathe) OTL(Auto_Peeling_Start_Enable) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[CARRIAGE HEAD CLOSING ADVANCE]]>
</Comment>
<Text>
<![CDATA[DIV(HMI_Lathe_Peel_Thickness1,10,_dummyDInt)[XIC(trash_gate_disable) MUL(_dummyDInt,1,_dummyDInt_x_2) ADD(Data_RoundupRad,_dummyDInt_x_2,_Data_CloseHeadBaseRad) ,XIO(trash_gate_disable) ADD(Data_RoundupRad,_dummyDInt,_Data_CloseHeadBaseRad) ]CPT(Data_CloseHeadRad,KC_ActSpeed_100*_Data_CloseHeadTime/1000+_Data_CloseHeadBaseRad);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[BACKUP DEVICE TO TRACKING ADVANCE



]]>
</Comment>
<Text>
<![CDATA[DIV(HMI_Lathe_Peel_Thickness1,10,_dummyDInt)ADD(Data_RoundupRad,_dummyDInt,_Data_BurToTrackingBaseRad)CPT(Data_BurToTrackingRad,KC_ActSpeed_100*_Data_BurToTrackingTime/1000+_Data_BurToTrackingBaseRad);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[MUL(HMI_Lathe_Man_Return_Rad,10,Lathe_ManualReturnRad);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[**********************************************************************************
**********Monitor If Data Is Changing From XY Between Logs**********
**********************************************************************************
Suspect XY PC data gets frozen from time to time and cause Lathe crashes]]>
</Comment>
<Text>
<![CDATA[GT(IO_XY_To_Lathe_DATA3,0)OTL(_CheckIfDataChange);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[EQ(IO_XY_To_Lathe_DATA3,0)OTU(_CheckIfDataChange);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Charger_Optim_ON)XIC(FROM_Charger_Rdy_TO_Run)XIC(FROM_ChargerSwing_ClampsUNCLPD)XIC(_CheckIfDataChange)ONS(_ONS_1.12)ADD(XY_Data_TX_Fails,1,XY_Data_TX_Fails);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[KNIFE CARRIAGE RETURN RADIUS]]>
</Comment>
<Text>
<![CDATA[GT(IO_XY_To_Lathe_DATA3,0)ADD(IO_XY_To_Lathe_DATA3,HMI_Lathe_Return_Add,Data_ReturnRad);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[LE(IO_XY_To_Lathe_DATA3,0)MOVE(Lathe_ManualReturnRad,Data_ReturnRad);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[PEELING STOPPED, UNLATCH SOME STATES]]>
</Comment>
<Text>
<![CDATA[XIC(FROM_ChargerSwing_AT_Lathe)[OTU(_InnerChucks_Extended) ,OTU(_MiddleChucks_Extended) ,OTU(_OuterChucks_Extended) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[POSITION LIMITS]]>
</Comment>
<Text>
<![CDATA[[LT(KC_Abs_Pos_10_mm,850) OTE(_Limits.0) ,LT(KC_Abs_Pos_10_mm,2000) OTE(_Limits.1) ,GT(KC_Abs_Pos_10_mm,1400) GT(Data_RoundupRad,1400) OTE(_Limits.2) ,LT(KC_Abs_Pos_10_mm,Data_RoundupRad) OTE(_Limits.3) ,LT(KC_Abs_Pos_10_mm,Data_RoundupPeelRad) OTE(_Limits.4) ,CMP(KC_Abs_Pos_10_mm<(Data_RoundupRadOriginal+(HMI_Lathe_Peel_Thickness1*0.3))) OTE(Limits_TrashGateClosingSpeed) ,[XIO(trash_gate_disable) LT(KC_Abs_Pos_10_mm,Data_RoundupRadOriginal) ,XIC(trash_gate_disable) XIC(KCStopped_CloseTrashGate) ] [OTE(_Limits.14) ,OTE(Limits_RoundupToPeel) ] ,LT(Data_HighSpeedRoundupRad,1450) MOVE(1450,Data_HighSpeedRoundupRad) ,GT(KC_Abs_Pos_10_mm,Data_HighSpeedRoundupRad) [OTE(_Limits.5) ,OTE(Limits_HighSpeedRoundup) ] ,LT(Data_VeryHighSpeedRoundupRad,1450) MOVE(1450,Data_VeryHighSpeedRoundupRad) ,GT(KC_Abs_Pos_10_mm,Data_VeryHighSpeedRoundupRad) OTE(Limits_VeryHighSpeedRoundup) ,ADD(Data_VeryHighSpeedRoundupRad,100,Data_FastForwardRad) GT(KC_Abs_Pos_10_mm,Data_FastForwardRad) OTE(Limits_FastForwardRad) ,LT(KC_Abs_Pos_10_mm,Data_CloseHeadRad) OTE(_Limits.6) ,LT(KC_Abs_Pos_10_mm,Data_BurToTrackingRad) ONS(_ONS_1.1) OTE(_Limits.7) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[LATHE STEP #1 - READY FOR NEW BLOCK]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[XIC(Lathe_Cycle_Reset) ,AFI() XIC(Lathe_Step_7) XIC(Timer_CoreDropSequence.DN) ]XIC(Spdls_InnerChucksRETRD)[MOVE(1,Lathe_Current_Step) ,OTE(Auto_Ready_For_New_Block) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[LATHE STEP #2 - EXTEND INNER SPINDLES]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIC(FROM_ChargerSwing_AT_Lathe)XIO(Spdls_InnerChucksEXTD)XIO(KC_Retracting)[XIO(Lathe_Spindle_Drive_Running) ,XIC(Spindles_RotatStopping) ]XIO(_InnerChucks_Extended)ONS(_ONS_1.4)[MOVE(2,Lathe_Current_Step) ,OTE(Auto_Extend_Inner_Spindles) ,OTL(_InnerChucks_Extended) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(Spindles_SmallSpindlesExtend)TON(T_InnerSpindlesAreClosing,?,?);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[LATHE STEP #3-  EXTEND MIDDLE SPINDLES]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[XIC(FROM_ChargerSwingCLR_OF_MChks) ,XIC(Always_1) ][XIC(Spdls_InnerChucksEXTD) ,XIC(T_InnerSpindlesAreClosing.DN) ]XIO(Spdls_MiddleChucksEXTD)XIO(_MiddleChucks_Extended)EQ(Lathe_Current_Step,2)ONS(_ONS_1.5)[MOVE(3,Lathe_Current_Step) ,OTE(Auto_Extend_Middle_Spindles) ,OTL(_MiddleChucks_Extended) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[LATHE STEP #4- EXTEND OUTER SPINDLES]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIO(Spindles_6ftBlock)XIC(FROM_ChargerSwingCLR_OF_BChks)XIC(Spdls_MiddleChucksEXTD)XIO(Spdls_OuterChucksEXTD)XIC(_Limits.2)XIO(_OuterChucks_Extended)ONS(_ONS_1.6)[MOVE(4,Lathe_Current_Step) ,OTE(Auto_Extend_Outer_Spindles) ,OTL(_OuterChucks_Extended) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIC(Spindles_Rotat_CMD)OTL(Auto_Rotation_has_been_on);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[LATHE STEP #5- START ROTATION]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[XIC(Auto_Extend_Middle_Spindles) XIC(_Limits.0) [XIC(FROM_ChargerSwing_ClampsUNCLPD) ,XIC(FROM_ChargerSwingCLR_OF_BChks) ] ,XIC(Spdls_MiddleChucksEXTD) [XIO(_Limits.2) ,] [XIC(FROM_ChargerSwingCLR_OF_BChks) ,XIC(FROM_ChargerSwing_ClampsUNCLPD) ] ,XIC(Spindles_6ftBlock) XIC(Spdls_MiddleChucksEXTD) [XIC(FROM_ChargerSwing_ClampsUNCLPD) ,XIC(FROM_ChargerSwingCLR_OF_BChks) ] ,[XIC(Auto_Extend_Outer_Spindles) ,] XIC(Spdls_MiddleChucksEXTD) XIC(_Limits.1) [XIC(FROM_ChargerSwingCLR_OF_BChks) ,XIC(FROM_ChargerSwing_ClampsUNCLPD) ] ,XIC(Spdls_OuterChucksEXTD) XIC(FROM_ChargerSwingCLR_OF_BChks) ]XIO(Lathe_Spindle_Drive_Running)XIO(Auto_Rotation_has_been_on)ONS(_ONS_1.7)[MOVE(5,Lathe_Current_Step) ,OTE(Auto_Start_Rotation) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[ROUNDUP HAS BEEN ON]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIC(KC_Steps.2)OTL(Auto_Roundup_Has_Been_On);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(Spindles_6ftBlock)XIC(BR_Retract_REQ)XIC(Bur_BottomRoll_Retracted)OTE(Auto_FeedingStart_DLY);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[LATHE STEP #6- ROUNDUP]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIO(Auto_Extend_Outer_Spindles)XIC(Lathe_Spindle_Drive_Running)XIO(KC_Steps.2)XIO(KC_Steps.3)XIO(KC_Steps.4)XIO(Auto_Roundup_Has_Been_On)XIC(Auto_Peeling_Start_Enable)[XIC(Auto_FeedingStart_DLY) ,XIO(Spindles_6ftBlock) ]ONS(_ONS_1.8)[MOVE(6,Lathe_Current_Step) ,OTE(Auto_Roundup) ,OTL(Auto_Roundup_Step_Has_Been_On) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[DISABLE HIGH SPEED ROUNDUP]]>
</Comment>
<Text>
<![CDATA[[XIC(OUT_JS_KnifeCarrForward) ,XIC(OUT_JS_KnifeCarrBackward) ,XIC(OUT_JS_Roundup) ,XIC(OUT_JS_RoundupPeel) ,XIC(OUT_JS_Peeling) ]XIC(Auto_High_Speed_Roundup)XIO(Spdls_InnerChucksRETRD)OTL(Auto_Disable_High_Speed_Roundup);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(Spdls_InnerChucksRETRD)OTU(Auto_Disable_High_Speed_Roundup);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[LATHE STEP #7- HIGH SPEED ROUNDUP]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)XIC(Lathe_Spindle_Drive_Running)XIC(Roundup_Automatic_Mode)XIC(Auto_Peeling_Start_Enable)XIC(Auto_Roundup_Has_Been_On)[XIC(_Limits.5) XIO(Auto_Disable_High_Speed_Roundup) [MOVE(7,Lathe_Current_Step) ,OTE(Auto_High_Speed_Roundup) ] ,OTE(Auto_Peeling_Enable) ];]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[PEELING HAS BEEN ON]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[XIC(Auto_High_Speed_Roundup) ,XIC(Auto_Peeling_Enable) XIO(_Limits.5) ]XIC(KC_Steps.4)OTL(Auto_Peeling_Has_Been_On);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[LATHE STEP #8 - PEELING]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[XIC(Auto_High_Speed_Roundup) ,XIC(Auto_Peeling_Enable) XIO(_Limits.5) ]XIO(KC_Steps.4)XIC(_Limits.4)XIO(Auto_Peeling_Has_Been_On)TON(Delay_Step_8,?,?)XIC(Delay_Step_8.DN)ONS(_ONS_1.9)[MOVE(8,Lathe_Current_Step) ,OTE(Auto_Peeling) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[JOYSTICK PEEL]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[XIC(Auto_High_Speed_Roundup) ,XIC(Auto_Peeling_Enable) XIO(_Limits.5) ]XIC(KC_Steps.4)XIC(KC_Steps.3)OTL(Auto_Joystick_Peel);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[LATHE STEP #9 - CLOSE CARRIAGE HEAD]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)[[XIC(Roundup_Automatic_Mode) XIO(Auto_Peeling_Start_Enable) ,XIO(Roundup_Automatic_Mode) ] XIC(KC_Steps.4) XIO(KC_Steps.3) ,[XIC(Auto_High_Speed_Roundup) ,XIC(Auto_Peeling_Enable) XIO(_Limits.5) ] XIC(KC_Steps.4) XIO(KC_Steps.3) [XIC(_Limits.6) ,XIC(Auto_Joystick_Peel) ] ]XIO(Roller_Bar_Is_Closed)ONS(_ONS_1.10)[MOVE(9,Lathe_Current_Step) ,OTE(Auto_Close_Carriage_Head) ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[PEELING STOPPED, UNLATCH SOME STATES]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Steps.6) ,XIO(KC_Steps.6) XIC(Spdls_InnerChucksRETRD) ,XIC(ErrorReset_Lathe) XIC(Always_0) ][OTU(Auto_Rotation_has_been_on) ,OTU(Auto_Roundup_Has_Been_On) ,OTU(Auto_Peeling_Has_Been_On) ,OTU(Auto_Joystick_Peel) ,OTU(Auto_Peeling_Start_Enable) ,OTU(Auto_Roundup_Step_Has_Been_On) ,OTU(Trashgate_Has_Been_Closed) ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[[XIO(_Step_Enable) ,XIC(KC_Retracting) ONS(ONS_Lathe1.21) ]MOVE(0,Lathe_Current_Step);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[LT(Lathe_Current_Step,1)OTE(Lathe_Step_1);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,2)OTE(Lathe_Step_2);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,3)OTE(Lathe_Step_3);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,4)OTE(Lathe_Step_4);]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,5)OTE(Lathe_Step_5);]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,6)OTE(Lathe_Step_6);]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,7)OTE(Lathe_Step_7);]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,8)OTE(Lathe_Step_8);]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[EQ(Lathe_Current_Step,9)OTE(Lathe_Step_9);]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Comment>
<![CDATA[OUTPUTS]]>
</Comment>
<Text>
<![CDATA[XIC(Lathe_Automatic_Mode)OTE(Q_PL_LatheAuto);]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Comment>
<![CDATA[ERRORS]]>
</Comment>
<Text>
<![CDATA[[XIC(KC_Steps.2) ,XIC(KC_Steps.3) ,XIC(KC_Steps.4) ]XIC(Spdls_InnerChucksEXTD)[XIO(I_PS_KnifeClampsClsd_Middle) CTU(Diagnostic[0],?,?) ,XIO(I_PS_KnifeClampsClsd_Outer) CTU(Diagnostic[1],?,?) ]OTL(Error_LatheMasterSeq.1);]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Comment>
<![CDATA[HMI]]>
</Comment>
<Text>
<![CDATA[XIC(Roundup_Automatic_Mode)OTE(HMI_Lathe_Switch_Lamps_05);]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Text>
<![CDATA[JSR(L90_LatheMasterSeqDiagnostic,0);]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Text>
<![CDATA[JSR(L99_LatheMasterSeqAlarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Use="Reference" Name="L90_LatheMasterSeqDiagnostic">
</Routine>
<Routine Use="Reference" Name="L99_LatheMasterSeqAlarms">
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
